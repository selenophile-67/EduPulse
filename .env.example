# --- Server ---
PORT=4100
NODE_ENV=development

# Public URL of the web client (used for CORS / origin checks)
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite database file (relative to server/)
DB_PATH=./data/edupulse.db

# --- Optional third-party integrations (Stage 2) ---
# Live class streaming (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI tutor (OpenAI-compatible endpoint)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Transactional email (password resets, notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Media storage (S3-compatible). When unset, local disk storage is used.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
